{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"project": [ "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}", "!scripts/architecture/**" ],
	"webpack": true,
	"jest": {
		"config": [ "jest-unit.config.js" ]
	},
	"playwright": {
		"config": [ "playwright.config.ts" ],
		"entry": [
			"tests/e2e/**/*.spec.ts",
			"tests/e2e/**/*.performance.ts",
			"tests/e2e/auth.setup.ts"
		]
	},
	"babel": {
		"config": [ "babel.i18n.config.js" ]
	},
	"eslint": true,
	"ignoreDependencies": [
		"@wordpress/jest-preset-default",
		"@redux-devtools/extension",
		"markdown-it"
	],
	"ignoreBinaries": [ "wp" ]
}
