{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Yamabiko Table Reorder Demo",
		"description": "Try row and column reordering with Yamabiko Table Reorder in both the WordPress Core Table and Flexible Table Block.",
		"author": "YamabikoLab",
		"categories": [ "demo", "table", "accessibility" ]
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "7.1"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"landingPage": "/wp-admin/post.php?post=100&action=edit",
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "en_GB",
			"progress": {
				"caption": "Setting up the English (UK) environment..."
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Yamabiko Table Reorder Demo",
				"blogdescription": "Try Yamabiko Table Reorder"
			},
			"progress": {
				"caption": "Setting up the demo site..."
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/YamabikoLab/yamabiko-table-reorder/releases/latest/download/yamabiko-table-reorder.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Yamabiko Table Reorder..."
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://downloads.wordpress.org/plugin/flexible-table-block.3.9.0.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Flexible Table Block v3.9.0..."
			}
		},
		{
			"step": "writeFile",
			"path": "/tmp/create-demo.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/YamabikoLab/yamabiko-table-reorder/main/demo/create-demo.php"
			},
			"progress": {
				"caption": "Preparing demo data..."
			}
		},
		{
			"step": "runPHPWithOptions",
			"options": {
				"scriptPath": "/tmp/create-demo.php"
			}
		}
	]
}
