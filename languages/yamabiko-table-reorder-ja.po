#. Plugin Name of the plugin
#: yamabiko-table-reorder.php
msgid "Yamabiko Table Reorder"
msgstr "Yamabiko Table Reorder"

#. Description of the plugin
#: yamabiko-table-reorder.php
msgid "Accessible table row reordering for supported blocks in the WordPress block editor."
msgstr "WordPressブロックエディターで、対応する表の行をアクセシブルに並べ替えます。"

#: src/editor-extensions/table-reorder/messages.ts:4
msgid "Empty row"
msgstr "空の行"

#: src/editor-extensions/table-reorder/messages.ts:8
msgid "Drag to move, or click to choose a destination."
msgstr "ドラッグで移動　クリックで移動先を選択"

#: src/editor-extensions/table-reorder/messages.ts:12
msgid "Enter / Space: start moving"
msgstr "Enter / Space: 移動開始"

#: src/editor-extensions/table-reorder/messages.ts:16
msgid "↑↓ Move　Enter / Space Confirm　Esc Cancel"
msgstr "↑↓ 移動　Enter / Space 決定　Esc キャンセル"

#: src/editor-extensions/table-reorder/messages.ts:20
msgid "Click destination　Esc Cancel"
msgstr "移動先をクリック　Esc キャンセル"

#: src/editor-extensions/table-reorder/messages.ts:24
msgid "Handle: drag to move / tap to choose destination　Cell: tap to edit"
msgstr "ハンドル: ドラッグで移動 / タップで移動先選択　セル: タップで編集"

#: src/editor-extensions/table-reorder/messages.ts:31
msgid "Tap destination"
msgstr "移動先をタップ"

#: src/editor-extensions/table-reorder/messages.ts:35
msgid "Reorder rows with the keyboard. Select “Reorder rows” in the toolbar, then use Tab / Shift+Tab to choose a row to reorder."
msgstr "キーボードで行を並べ替えられます。ツールバーの「行を並べ替え」を選択し、Tab / Shift+Tab で並べ替える行を選べます。"

#: src/editor-extensions/table-reorder/messages.ts:42
msgid "Tap “Reorder rows” in the toolbar to begin."
msgstr "ツールバーの「行を並べ替え」をタップして開始"

#. 1: row number, 2: representative row text.
#: src/editor-extensions/table-reorder/messages.ts:52
msgid "Reorder row %1$d: %2$s"
msgstr "%1$d行目「%2$s」を並べ替え"

#: src/editor-extensions/table-reorder/messages.ts:58
msgid "Drag to move this row, or activate to choose a destination."
msgstr "ドラッグして行を移動できます。実行すると移動先を選択できます。"

#: src/editor-extensions/table-reorder/messages.ts:62
msgid "Press Enter or Space to start moving this row."
msgstr "EnterまたはSpaceキーで、この行の移動を開始します。"

#. 1: row number, 2: representative row text.
#: src/editor-extensions/table-reorder/messages.ts:72
msgid "Move before row %1$d: %2$s"
msgstr "%1$d行目「%2$s」の前へ移動"

#: src/editor-extensions/table-reorder/messages.ts:78
msgid "Move to the end of the table."
msgstr "表の末尾へ移動"

#: src/editor-extensions/table-reorder/messages.ts:81
msgid "Cancel"
msgstr "キャンセル"

#: src/editor-extensions/table-reorder/messages.ts:84
msgid "Close guidance"
msgstr "案内を閉じる"

#: src/editor-extensions/table-reorder/messages.ts:87
msgid "Reorder rows"
msgstr "行を並べ替え"

#: src/editor-extensions/table-reorder/messages.ts:91
msgid "Move table rows using drag and drop, the keyboard, or destination selection."
msgstr "ドラッグ、キーボード、または移動先の選択で表の行を移動します。"

#: src/editor-extensions/table-reorder/messages.ts:98
msgid "This row is in a row-spanning cell and can’t be moved."
msgstr "この行は縦結合セル内のため移動できません。"

#: src/editor-extensions/table-reorder/messages.ts:102
msgid "No rows can be reordered."
msgstr "並べ替えできる行がありません。"

#. 1: representative row text, 2: current row number, 3: total row count.
#: src/editor-extensions/table-reorder/messages.ts:117
msgid "Moving %1$s, row %2$d of %3$d."
msgstr "%1$s、全%3$d行中%2$d行目の移動を開始しました。"

#. 1: representative row text.
#: src/editor-extensions/table-reorder/messages.ts:128
msgid "%1$s selected. Choose a destination."
msgstr "%1$sを選択しました。移動先を選んでください。"

#. 1: representative row text, 2: destination row number, 3: total row count.
#: src/editor-extensions/table-reorder/messages.ts:145
msgid "Move %1$s to position %2$d of %3$d."
msgstr "%1$sを全%3$d行中%2$d行目へ移動します。"

#. 1: representative row text, 2: original row number, 3: destination row number.
#: src/editor-extensions/table-reorder/messages.ts:162
msgid "Moved %1$s from position %2$d to %3$d."
msgstr "%1$sを%2$d行目から%3$d行目へ移動しました。"

#. 1: representative row text, 2: unchanged row number.
#: src/editor-extensions/table-reorder/messages.ts:174
msgid "Canceled moving %1$s. It remains at position %2$d."
msgstr "%1$sの移動をキャンセルしました。位置は%2$d行目のままです。"

#: src/editor-extensions/table-reorder/messages.ts:196
msgid "up"
msgstr "上"

#: src/editor-extensions/table-reorder/messages.ts:197
msgid "down"
msgstr "下"

#. 1: representative row text, 2: translated movement direction.
#: src/editor-extensions/table-reorder/messages.ts:199
msgid "%1$s cannot move any farther %2$s."
msgstr "%1$sは、これ以上%2$sへ移動できません。"

#. 1: representative row text.
#: src/editor-extensions/table-reorder/messages.ts:210
msgid "%1$s cannot be moved because it is within a cell that spans multiple rows."
msgstr "%1$sは、複数行にまたがる結合セルの範囲内にあるため移動できません。"

#: src/editor-extensions/table-reorder/messages.ts:219
msgid "There are no rows that can be reordered in this table."
msgstr "この表には並べ替えできる行がありません。"

#. Author of the plugin
#: yamabiko-table-reorder.php
msgid "YamabikoLab"
msgstr ""
