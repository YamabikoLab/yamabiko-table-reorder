#. Plugin Name of the plugin
#: src/messages.ts:10
#: yamabiko-table-reorder.php
msgid "Yamabiko Table Reorder"
msgstr "Yamabiko Table Reorder"

#. Author of the plugin
#: yamabiko-table-reorder.php
msgid "YamabikoLab"
msgstr ""

#. Description of the plugin
#: yamabiko-table-reorder.php
msgid "Table reordering for supported blocks in the WordPress block editor."
msgstr ""

#: src/messages.ts:17
msgid "Reorder rows"
msgstr "行を並び替え"

#: src/messages.ts:24
msgid "Reorder columns"
msgstr "列を並び替え"

#: src/messages.ts:32
msgid "Cannot move because cells are merged."
msgstr "セルが結合されているため、移動できません。"

#: src/messages.ts:40
msgid "Reordering could not continue, so the operation was ended."
msgstr "並び替えを続けられないため、操作を終了しました。"

#: src/messages.ts:47
msgid "Reorder rows and columns."
msgstr "行と列を並び替えられます。"

#: src/messages.ts:55
msgid "Close reorder guidance"
msgstr "並び替えの案内を閉じる"

#: src/messages.ts:59
msgid "Apply the new order?"
msgstr "並び替えを反映しますか？"

#: src/messages.ts:63
msgid "Applying this reorder may take some time. Do you want to continue?"
msgstr "この並び替えの反映には時間がかかる場合があります。続行しますか？"

#: src/messages.ts:67
msgid "Continue"
msgstr "続行"

#: src/messages.ts:70
msgid "Cancel"
msgstr "キャンセル"

#: src/messages.ts:74
msgid "Applying the new order…"
msgstr "並び替えを反映しています…"
