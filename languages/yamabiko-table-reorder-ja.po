#. Plugin Name of the plugin
#: src/messages.ts:10
#: yamabiko-table-reorder.php
#: yamabiko-table-reorder.php:66
msgid "Yamabiko Table Reorder"
msgstr "Yamabiko Table Reorder"

#. Author of the plugin
#: yamabiko-table-reorder.php
msgid "YamabikoLab"
msgstr ""

#. Description of the plugin
#: yamabiko-table-reorder.php
msgid "Table reordering for supported blocks in the WordPress block editor."
msgstr ""

#: src/messages.ts:17
msgid "Reorder rows"
msgstr "行を並び替え"

#: src/messages.ts:24
msgid "Reorder columns"
msgstr "列を並び替え"

#. 1: 1-based row number, 2: first 1-based column number, 3: last 1-based column number
#: src/messages.ts:175
msgid "A merged cell in row %1$d spanning columns %2$d–%3$d prevents this move."
msgstr "%1$d行目の%2$d〜%3$d列目に結合セルがあるため、この指定では移動できません。"

#. 1: first 1-based row number, 2: last 1-based row number, 3: 1-based column number
#: src/messages.ts:185
msgid "A merged cell spanning rows %1$d–%2$d in column %3$d prevents this move."
msgstr "%1$d〜%2$d行目の%3$d列目に結合セルがあるため、この指定では移動できません。"

#. 1: first 1-based row number, 2: last 1-based row number, 3: first 1-based column number, 4: last 1-based column number
#: src/messages.ts:193
msgid "A merged cell spanning rows %1$d–%2$d and columns %3$d–%4$d prevents this move."
msgstr "%1$d〜%2$d行目の%3$d〜%4$d列目に結合セルがあるため、この指定では移動できません。"

#: src/messages.ts:227
msgid "header"
msgstr "ヘッダー"

#: src/messages.ts:228
msgid "footer"
msgstr "フッター"

#. 1: table section name, 2: 1-based row number, 3: first 1-based column number, 4: last 1-based column number
#: src/messages.ts:233
msgid "A merged cell in %1$s row %2$d spanning columns %3$d–%4$d prevents this move."
msgstr "%1$sの%2$d行目の%3$d〜%4$d列目に結合セルがあるため、この指定では移動できません。"

#. 1: table section name, 2: first 1-based row number, 3: last 1-based row number, 4: first 1-based column number, 5: last 1-based column number
#: src/messages.ts:241
msgid "A merged cell spanning %1$s rows %2$d–%3$d and columns %4$d–%5$d prevents this move."
msgstr "%1$sの%2$d〜%3$d行目の%4$d〜%5$d列目に結合セルがあるため、この指定では移動できません。"

#: src/messages.ts:300
msgid "Reordering could not continue, so the operation was ended."
msgstr "並び替えを続けられないため、操作を終了しました。"

#: src/messages.ts:327
msgid "Close reorder guidance"
msgstr "並び替えの案内を閉じる"

#: src/messages.ts:331
msgid "Apply the new order?"
msgstr "並び替えを反映しますか？"

#. 1: 移動元の行番号, 2: 移動先の行番号
#: src/messages.ts:345
msgid "Row %1$d → %2$d"
msgstr "%1$d行目 → %2$d行目"

#. 1: 移動元の列番号, 2: 移動先の列番号
#: src/messages.ts:361
msgid "Column %1$d → %2$d"
msgstr "%1$d列目 → %2$d列目"

#: src/messages.ts:367
msgid "Applying this reorder may take some time."
msgstr "この並び替えの反映には時間がかかる場合があります。"

#: src/messages.ts:370
msgid "Continue"
msgstr "続行"

#: src/messages.ts:373
msgid "Cancel"
msgstr "キャンセル"

#: src/messages.ts:377
msgid "Applying the new order…"
msgstr "並び替えを反映しています…"

#: src/messages.ts:381
msgid "Please wait until the update is complete."
msgstr "完了するまでしばらくお待ちください。"

#: src/messages.ts:385
msgid "Reordering complete."
msgstr "並び替えが完了しました。"

#. %d: 1-based column number
#: src/messages.ts:137
msgid "Column %d"
msgstr "%d列目"

#: src/messages.ts:143
msgid "This selection won't change the order."
msgstr "この指定では並び順は変わりません。"

#: src/messages.ts:147
msgid "This reorder can't continue with the current table. Check the table and try again."
msgstr "現在のテーブルでは、この並び替えを続行できません。テーブルの状態を確認して、もう一度お試しください。"

#: src/messages.ts:252
msgid "Reorder"
msgstr "並び替え"

#: src/messages.ts:34
msgid "Reorder with form"
msgstr "フォームで並び替え"

#: src/messages.ts:60
msgid "Rows"
msgstr "行"

#: src/messages.ts:63
msgid "Columns"
msgstr "列"

#: src/messages.ts:66
msgid "Row to move"
msgstr "移動する行"

#: src/messages.ts:69
msgid "Target row"
msgstr "移動先の行"

#: src/messages.ts:72
msgid "Position"
msgstr "位置"

#: src/messages.ts:75
msgid "Above"
msgstr "上"

#: src/messages.ts:78
msgid "Below"
msgstr "下"

#. %d: current tbody row count
#: src/messages.ts:88
msgid "Enter an integer from 1 to %d."
msgstr "1〜%dの整数を入力してください。"

#: src/messages.ts:94
msgid "Move the row above or below the target row."
msgstr "移動先の行の上または下へ移動します。"

#: src/messages.ts:97
msgid "Column to move"
msgstr "移動する列"

#: src/messages.ts:100
msgid "Target column"
msgstr "移動先の列"

#: src/messages.ts:103
msgid "Select a column"
msgstr "列を選択"

#: src/messages.ts:113
msgid "Left"
msgstr "左"

#: src/messages.ts:116
msgid "Right"
msgstr "右"

#: src/messages.ts:120
msgid "Move the column to the left or right of the target column."
msgstr "移動先の列の左または右へ移動します。"

#. 1: column heading, 2: 1-based column number
#: src/messages.ts:132
msgid "%1$s (Column %2$d)"
msgstr "%1$s（%2$d列目）"

#: src/messages.ts:28
msgid "Column drag reordering is unavailable in the current view. You can reorder columns using the form."
msgstr "現在の表示では列のドラッグ並び替えを使用できません。列の並び替えはフォームから行えます。"

#: src/messages.ts:308
msgid "Reorder rows and columns by dragging or using the form."
msgstr "行・列をドラッグまたはフォームで並び替えられます。"

#: src/messages.ts:316
msgid "Long press a cell, then drag, or use the form to reorder rows and columns."
msgstr "セルを長押ししてからドラッグするか、フォームを使って行・列を並び替えられます。"

#: src/messages.ts:107
msgid "The selected column is no longer available. Select a column again."
msgstr "選択していた列は現在利用できません。列をもう一度選択してください。"

#: src/messages.ts:260
msgid "The reorder could not be completed. The table was not changed."
msgstr "並び替えを完了できませんでした。テーブルは変更されていません。"

#. 1: 1-based source row position, 2: 1-based final row position
#: src/messages.ts:274
msgid "Moved row %1$d to position %2$d."
msgstr "%1$d行目を%2$d行目の位置へ移動しました。"

#. 1: 1-based source column position, 2: 1-based final column position
#: src/messages.ts:290
msgid "Moved column %1$d to position %2$d."
msgstr "%1$d列目を%2$d列目の位置へ移動しました。"

#: src/messages.ts:37
msgid "Reorder with chat"
msgstr "チャットで並び替え"

#: src/messages.ts:40
msgid "Reorder request"
msgstr "並び替えの依頼"

#: src/messages.ts:43
msgid "Send"
msgstr "送信"

#: src/messages.ts:47
msgid "The AI response could not be used. Try the request again."
msgstr "AIの応答を利用できませんでした。もう一度お試しください。"

#: src/messages.ts:51
msgid "The specified column could not be identified uniquely in the current table."
msgstr "指定された列を現在の表で一意に特定できませんでした。"

#: yamabiko-table-reorder.php:67
msgid "Yamabiko Table Reorder integration abilities."
msgstr "Yamabiko Table Reorderの連携用Abilityです。"

#: yamabiko-table-reorder.php:87
msgid "Get reorder contract"
msgstr "並び替えコントラクトを取得"

#: yamabiko-table-reorder.php:88
msgid "Returns the compact command contract accepted by the Yamabiko Table Reorder chat proof of concept."
msgstr "Yamabiko Table ReorderのチャットPoCが受け付ける簡潔なコマンドコントラクトを返します。"

#: yamabiko-table-reorder.php:125
msgid "Normalize reorder command"
msgstr "並び替えコマンドを正規化"

#: yamabiko-table-reorder.php:126
msgid "Normalizes a natural-language reorder request into the strict RF command text accepted by Yamabiko Table Reorder."
msgstr "自然言語の並び替え依頼を、Yamabiko Table Reorderが受け付ける厳密なRFコマンド文字列へ正規化します。"
