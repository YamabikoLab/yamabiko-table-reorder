#. Plugin Name of the plugin
#: src/messages.ts:10
#: yamabiko-table-reorder.php
msgid "Yamabiko Table Reorder"
msgstr "Yamabiko Table Reorder"

#. Author of the plugin
#: yamabiko-table-reorder.php
msgid "YamabikoLab"
msgstr ""

#. Description of the plugin
#: yamabiko-table-reorder.php
msgid "Table reordering for supported blocks in the WordPress block editor."
msgstr ""

#: src/messages.ts:17
msgid "Reorder rows"
msgstr "行を並び替え"

#: src/messages.ts:24
msgid "Reorder columns"
msgstr "列を並び替え"

#: src/messages.ts:32
#: src/messages.ts:40
msgid "Cannot move because cells are merged."
msgstr "セルが結合されているため、移動できません。"

#: src/messages.ts:48
msgid "Reordering could not continue, so the operation was ended."
msgstr "並び替えを続けられないため、操作を終了しました。"

#: src/messages.ts:56
msgid "Reorder rows and columns."
msgstr "行と列を並び替えられます。"

#: src/messages.ts:64
msgid "Close reorder guidance"
msgstr "並び替えの案内を閉じる"

#: src/messages.ts:68
msgid "Apply the new order?"
msgstr "並び替えを反映しますか？"

#. translators: 1: 移動元の行番号, 2: 移動先の行番号
#: src/messages.ts:82
msgid "Row %1$d → %2$d"
msgstr "%1$d行目 → %2$d行目"

#. translators: 1: 移動元の列番号, 2: 移動先の列番号
#: src/messages.ts:98
msgid "Column %1$d → %2$d"
msgstr "%1$d列目 → %2$d列目"

#: src/messages.ts:104
msgid "Applying this reorder may take some time."
msgstr "この並び替えの反映には時間がかかる場合があります。"

#: src/messages.ts:107
msgid "Continue"
msgstr "続行"

#: src/messages.ts:110
msgid "Cancel"
msgstr "キャンセル"

#: src/messages.ts:114
msgid "Applying the new order…"
msgstr "並び替えを反映しています…"
